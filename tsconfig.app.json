{
  "compilerOptions": {
    /* Wajib untuk project yang dirujuk lewat "references" di tsconfig.json. */
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Paths — relatif terhadap file ini, jadi tidak perlu "baseUrl".
       Tanpa baseUrl, import telanjang seperti 'components/Foo' juga tidak
       ikut ter-resolve, sehingga dependensi yang hilang tetap ketahuan. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
